# Discord bot token (Developer Portal > Bot)
DISCORD_TOKEN=

# EVE application from https://developers.eveonline.com
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=

# Public URL of this service. The EVE application's callback URL must be
# this plus /callback, for example https://standings.example.com/callback
PUBLIC_URL=

# Contact CCP can reach you at if the bot misbehaves, for example eve:Character Name,
# discord:username or an email. It is sent in the user agent of every ESI request.
CONTACT=

# Optional
# STANDING=6.7
# BIND_ADDR=0.0.0.0:8080
# DATABASE_PATH=standing-bot.db
